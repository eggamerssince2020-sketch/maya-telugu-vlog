# ==============================================================================
# Maya Telugu Vlog - Environment Configuration (Supports 100% Zero-Cost Setup)
# ==============================================================================

# LLM Engine (OpenRouter API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ZERO-COST FREE MODELS (No credit card required on OpenRouter):
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemini-2.0-flash-exp:free
# - nousresearch/hermes-3-llama-3.1-405b:free
STORY_ARCHITECT_MODEL=meta-llama/llama-3.3-70b-instruct:free
TELUGU_WRITER_MODEL=google/gemini-2.0-flash-exp:free

# Image Generation Configuration
# Providers: 'auto', 'together', 'huggingface', 'fal', 'pollinations'
# - together: $5 free credits on signup at together.ai (~1,600+ photorealistic Flux.1 images) [RECOMMENDED]
# - huggingface: Free token at huggingface.co/settings/tokens (serverless FLUX.1-schnell)
# - fal: Fal.ai Flux LoRA (free starter credits at fal.ai)
# - pollinations: Fallback free public server
IMAGE_PROVIDER=auto
TOGETHER_API_KEY=
HF_TOKEN=
FAL_KEY=
FAL_LORA_URL=https://huggingface.co/XLabs-AI/flux-lora-collection/resolve/main/flux-realism-lora.safetensors
FAL_LORA_SCALE=0.95
MAYA_TRIGGER_WORD=maya_south_indian
FAL_ENABLE_SAFETY_CHECKER=false

# Supabase (PostgreSQL Database - 100% FREE Tier: 500MB DB, 50k MAU)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Telegram Channel & Bot Settings (100% FREE forever)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_or_chat_id
TELEGRAM_SPOILER_BLUR=true

# Execution Modes
DRY_RUN=false
MOCK_MODE=false
